#	Box: Generic p291 based tvbox - Amlogic GXLX2 (S905L-3) - 2GB - 100M
#
# Comments are only allowed at the beginning of a line

dtb_img=dtb-${release}/amlogic/meson-gxl-s905l3-p291-generic.dtb

load_config0=gx-default-${variant}.config

bootargs0=watchdog.stop_on_reboot=0 pd_ignore_unused clk_ignore_unused

# debug=y
load_config5=gx-debug-${variant}-${debug}.config

# warning, make sure this file ends with a newline!
